rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isGoogleUser() {
      return signedIn() && request.auth.token.email is string &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isAdmin() {
      return isGoogleUser() && request.auth.token.email == 'nickpatel.trainer@gmail.com';
    }
    function activeHost(uid) {
      return isGoogleUser() && request.auth.uid == uid &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }
    function session(code) {
      return get(/databases/$(database)/documents/liveGames/$(code));
    }
    function isHost(code) {
      return activeHost(request.auth.uid) && session(code).data.hostUid == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isGoogleUser() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'organisationName', 'role', 'status',
          'createdAt', 'updatedAt', 'lastLoginAt'
        ]) && request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'active' &&
        request.resource.data.role == (isAdmin() ? 'admin' : 'host');
      allow update: if (
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['active', 'suspended']
      ) || (
        isGoogleUser() && request.auth.uid == uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'organisationName', 'updatedAt', 'lastLoginAt'])
      );
      allow delete: if false;

      match /quizzes/{quizId} {
        allow get, list: if activeHost(uid) || isAdmin();
        allow create: if activeHost(uid) && request.resource.data.ownerUid == uid;
        allow update: if activeHost(uid) && resource.data.ownerUid == uid && request.resource.data.ownerUid == uid;
        allow delete: if activeHost(uid) && resource.data.ownerUid == uid;
      }

      match /quizDeletions/{quizId} {
        allow get, list: if activeHost(uid);
        allow create, update: if activeHost(uid) &&
          request.resource.data.keys().hasOnly(['ownerUid', 'deletedAtMs']) &&
          request.resource.data.ownerUid == uid && request.resource.data.deletedAtMs is int;
        allow delete: if activeHost(uid) || isAdmin();
      }

      match /sessions/{code} {
        allow get, list: if activeHost(uid) || isAdmin();
        allow create: if activeHost(uid) && request.resource.data.ownerUid == uid && request.resource.data.code == code;
        allow update: if activeHost(uid) && resource.data.ownerUid == uid && request.resource.data.ownerUid == uid && request.resource.data.code == code;
        allow delete: if (activeHost(uid) && resource.data.ownerUid == uid) || isAdmin();
      }
    }

    match /quizTemplates/{quizId} {
      // Legacy single-owner library: retained only as an admin migration source.
      allow read, create, update, delete: if isAdmin();
    }

    match /liveGames/{code} {
      allow get: if true;
      allow list: if false;
      allow delete: if isHost(code) || isAdmin();
      allow create: if activeHost(request.auth.uid) &&
        request.resource.data.keys().hasOnly(['hostUid', 'controllerId', 'memberUids', 'stateVersion', 'answerCount', 'game']) &&
        request.resource.data.hostUid == request.auth.uid && request.resource.data.memberUids == [] &&
        request.resource.data.stateVersion is int &&
        (!request.resource.data.keys().hasAny(['answerCount']) || request.resource.data.answerCount == 0);
      allow update: if (
        isHost(code) && request.resource.data.hostUid == resource.data.hostUid &&
        request.resource.data.memberUids == resource.data.memberUids &&
        (
          (request.resource.data.stateVersion == resource.data.stateVersion + 1 &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stateVersion', 'answerCount', 'game', 'openedAtServer', 'endedAt', 'deleteAfterMs'])) ||
          (request.resource.data.stateVersion == resource.data.stateVersion &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['controllerId']))
        )
      ) || (
        signedIn() && resource.data.memberUids.size() < 50 &&
        !resource.data.memberUids.hasAny([request.auth.uid]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) &&
        request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
        request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
        request.resource.data.memberUids.hasAny([request.auth.uid]) &&
        resource.data.game.phase != 'thanks' && resource.data.game.phase != 'closed-game' &&
        (resource.data.game.phase == 'lobby' || resource.data.game.allowLateJoins == true)
      ) || (
        signedIn() && resource.data.memberUids.hasAny([request.auth.uid]) &&
        resource.data.game.phase == 'open' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answerCount']) &&
        request.resource.data.answerCount == resource.data.get('answerCount', 0) + 1 &&
        !exists(/databases/$(database)/documents/liveGames/$(code)/responses/$(request.auth.uid + '_' + resource.data.game.questions[resource.data.game.questionIndex].id)) &&
        existsAfter(/databases/$(database)/documents/liveGames/$(code)/responses/$(request.auth.uid + '_' + resource.data.game.questions[resource.data.game.questionIndex].id)) &&
        getAfter(/databases/$(database)/documents/liveGames/$(code)/responses/$(request.auth.uid + '_' + resource.data.game.questions[resource.data.game.questionIndex].id)).data.playerId == request.auth.uid
      );

      match /private/{documentId} {
        allow get, list: if isHost(code);
        allow create: if activeHost(request.auth.uid) && documentId == 'engine' &&
          getAfter(/databases/$(database)/documents/liveGames/$(code)).data.hostUid == request.auth.uid &&
          request.resource.data.hostUid == request.auth.uid;
        allow update: if isHost(code) && documentId == 'engine' &&
          request.resource.data.hostUid == resource.data.hostUid &&
          request.resource.data.stateVersion == resource.data.stateVersion + 1;
        allow delete: if isHost(code) || isAdmin();
      }

      match /players/{uid} {
        allow get: if isHost(code) || (signedIn() && request.auth.uid == uid);
        allow list: if exists(/databases/$(database)/documents/liveGames/$(code));
        allow create: if signedIn() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['name', 'avatarId']) &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 24 && request.resource.data.avatarId is string &&
          getAfter(/databases/$(database)/documents/liveGames/$(code)).data.memberUids.hasAny([uid]);
        allow update: if false;
        allow delete: if isHost(code) || isAdmin();
      }

      match /responses/{responseId} {
        function validSubmission() {
          let live = session(code).data;
          return signedIn() && live.memberUids.hasAny([request.auth.uid]) && live.game.phase == 'open' &&
            (!live.game.keys().hasAny(['questionEligiblePlayerIds']) || live.game.questionEligiblePlayerIds.hasAny([request.auth.uid])) &&
            request.resource.data.keys().hasOnly(['playerId', 'questionId', 'value', 'submittedAt', 'submittedAtServer']) &&
            request.resource.data.playerId == request.auth.uid &&
            request.resource.data.questionId == live.game.questions[live.game.questionIndex].id &&
            responseId == request.auth.uid + '_' + request.resource.data.questionId &&
            request.resource.data.submittedAt is int &&
            request.resource.data.submittedAtServer == request.time &&
            request.time < live.openedAtServer + duration.value(live.game.questions[live.game.questionIndex].duration, 's');
        }
        allow get: if isHost(code) || (signedIn() && responseId.matches('^' + request.auth.uid + '_[^/]+$'));
        allow list: if isHost(code);
        allow create: if validSubmission();
        allow update: if false;
        allow delete: if isHost(code) || isAdmin();
      }

      match /results/{resultId} {
        allow get: if isHost(code) || (signedIn() && resultId.matches('^' + request.auth.uid + '_[^/]+$'));
        allow list: if isHost(code);
        allow create, update: if isHost(code);
        allow delete: if isHost(code) || isAdmin();
      }
    }
  }
}
