rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function approvedHost() {
      return signedIn() &&
        request.auth.token.email == 'nickpatel.trainer@gmail.com' &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function session(code) {
      return get(/databases/$(database)/documents/liveGames/$(code));
    }
    function isHost(code) {
      return approvedHost() && session(code).data.hostUid == request.auth.uid;
    }

    match /liveGames/{code} {
      allow get: if true; // Knowing the join code permits the public presentation state.
      allow list, delete: if false;
      allow create: if approvedHost() &&
        request.resource.data.keys().hasOnly(['hostUid', 'controllerId', 'memberUids', 'stateVersion', 'game']) &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.memberUids == [] &&
        request.resource.data.stateVersion is int;
      allow update: if (
        isHost(code) &&
        request.resource.data.hostUid == resource.data.hostUid &&
        request.resource.data.memberUids == resource.data.memberUids &&
        (
          (request.resource.data.stateVersion == resource.data.stateVersion + 1 &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stateVersion', 'game', 'openedAtServer'])) ||
          (request.resource.data.stateVersion == resource.data.stateVersion &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['controllerId']))
        )
      ) || (
        signedIn() &&
        resource.data.memberUids.size() < 50 &&
        !resource.data.memberUids.hasAny([request.auth.uid]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids']) &&
        request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
        request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
        request.resource.data.memberUids.hasAny([request.auth.uid]) &&
        (resource.data.game.phase == 'lobby' || resource.data.game.allowLateJoins == true)
      );

      match /private/{documentId} {
        allow get, list: if isHost(code);
        allow create: if approvedHost() && documentId == 'engine' &&
          getAfter(/databases/$(database)/documents/liveGames/$(code)).data.hostUid == request.auth.uid &&
          request.resource.data.hostUid == request.auth.uid;
        allow update: if isHost(code) && documentId == 'engine' &&
          request.resource.data.hostUid == resource.data.hostUid &&
          request.resource.data.stateVersion == resource.data.stateVersion + 1;
        allow delete: if false;
      }

      match /players/{uid} {
        allow get: if isHost(code) || (signedIn() && request.auth.uid == uid);
        // Player names and avatars are public within a game; answers stay private.
        allow list: if exists(/databases/$(database)/documents/liveGames/$(code));
        allow create: if signedIn() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['name', 'avatarId']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24 &&
          request.resource.data.avatarId is string &&
          getAfter(/databases/$(database)/documents/liveGames/$(code)).data.memberUids.hasAny([uid]);
        allow update, delete: if false;
      }

      match /responses/{responseId} {
        function validSubmission() {
          let live = session(code).data;
          return signedIn() && live.memberUids.hasAny([request.auth.uid]) &&
            live.game.phase == 'open' &&
            request.resource.data.keys().hasOnly(['playerId', 'questionId', 'value', 'submittedAt']) &&
            request.resource.data.playerId == request.auth.uid &&
            request.resource.data.questionId == live.game.questions[live.game.questionIndex].id &&
            responseId == request.auth.uid + '_' + request.resource.data.questionId &&
            request.resource.data.submittedAt is int &&
            request.resource.data.submittedAt >= request.time.toMillis() - 5000 &&
            request.resource.data.submittedAt <= request.time.toMillis() + 5000 &&
            request.time < live.openedAtServer + duration.value(live.game.questions[live.game.questionIndex].duration, 's');
        }
        // The deterministic ID also permits reading an as-yet-missing own answer.
        allow get: if isHost(code) ||
          (signedIn() && responseId.matches('^' + request.auth.uid + '_[^/]+$'));
        allow list: if isHost(code);
        allow create: if validSubmission();
        allow update: if false; // One authoritative answer per Player and question.
        allow delete: if false;
      }

      match /results/{resultId} {
        allow get: if isHost(code) ||
          (signedIn() && resultId.matches('^' + request.auth.uid + '_[^/]+$'));
        allow list: if isHost(code);
        allow create, update: if isHost(code);
        allow delete: if false;
      }
    }
  }
}
